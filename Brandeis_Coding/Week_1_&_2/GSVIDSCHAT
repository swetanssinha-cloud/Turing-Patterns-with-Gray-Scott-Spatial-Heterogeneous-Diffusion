import numpy as np
import matplotlib.pyplot as plt
import os
import subprocess
import shutil

# --- PARAMETERS ---
Du, Dv = 0.16, 0.08
F, k = 0.046, 0.064
N = 200
L = 200
dx = L / N
dt = 1
n_frames = 300
steps_per_frame = 100

# --- LAPLACIAN FUNCTION ---
def laplacian(Z, dx):
    d2Z_dx2 = np.roll(Z, 1, 0) - 2 * Z + np.roll(Z, -1, 0)
    d2Z_dy2 = np.roll(Z, 1, 1) - 2 * Z + np.roll(Z, -1, 1)
    return (d2Z_dx2 + d2Z_dy2) / (dx * dx)

# --- SOLVER FUNCTION ---
def solver(U, V, Du, Dv, F, k, dx, dt):
    Lu = laplacian(U, dx)
    Lv = laplacian(V, dx)
    uvv = U * V * V
    U += (Du * Lu - uvv + F * (1 - U)) * dt
    V += (Dv * Lv + uvv - (F + k) * V) * dt
    return U, V

# --- INITIAL CONDITIONS ---
U = np.ones((N, N))
V = np.zeros((N, N))
r = 20
U[N//2 - r:N//2 + r, N//2 - r:N//2 + r] = 0.50
V[N//2 - r:N//2 + r, N//2 - r:N//2 + r] = 0.25
U += 0.05 * np.random.rand(N, N)
V += 0.05 * np.random.rand(N, N)

# --- SETUP FRAME OUTPUT ---
frame_dir = 'frames'
os.makedirs(frame_dir, exist_ok=True)

# --- GENERATE AND SAVE FRAMES ---
for i in range(n_frames):
    for _ in range(steps_per_frame):
        U, V = solver(U, V, Du, Dv, F, k, dx, dt)

    plt.imshow(V, cmap='viridis', interpolation='bilinear', vmin=0, vmax=0.45)
    plt.axis('off')
    frame_filename = os.path.join(frame_dir, f'frame_{i:04d}.png')
    plt.savefig(frame_filename, bbox_inches='tight', pad_inches=0, dpi=150)
    plt.clf()

# --- CREATE VIDEO WITH FFMPEG ---
output_video = "Gray_Scott_Video.mp4"
ffmpeg_command = [
    "ffmpeg",
    "-y",                     # Overwrite without asking
    "-r", "30",               # FPS
    "-f", "image2",
    "-i", f"{frame_dir}/frame_%04d.png",
    "-vcodec", "libx264",
    "-crf", "20",
    "-pix_fmt", "yuv420p",
    output_video
]

print("Creating video...")
subprocess.run(ffmpeg_command, check=True)
print(f"Video saved as {output_video}")